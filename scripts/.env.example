# ============================================================================
# Sticky Kee 部署配置（scripts/deploy.sh 使用）——通用模板
# 用法：cp .env.example .env 后按需修改；.env 已 gitignore，不会入库。
# 说明：本模板只含部署层通用项（容器/端口/数据卷/时区）。
#       业务密钥（HA 地址与 Token、扫码 API key 等）在应用启动后的「系统配置」里填，
#       不进 Docker 环境变量。
# ============================================================================

# ---- 容器与镜像 ----
CONTAINER=stickykee
IMAGE=stickykee:latest
# APK 编译用的构建镜像名（deploy.sh apk / update 使用）
BUILDER=stickykee-apk-builder:latest
# builder 镜像的 base（拉不到 docker.io 时指向可达的 ubuntu:22.04，如 docker.1ms.run/...）
# 默认 ubuntu:22.04；设了非默认值时 deploy.sh 会以 --build-arg BUILDER_BASE=... 构建
# BUILDER_BASE=ubuntu:22.04

# ---- 端口 ----
# 容器使用 host 网络（不再做端口映射）：应用直接监听宿主机 PORT。
# PORT 仅用于 deploy.sh status 的健康检查地址。
PORT=18480

# ---- 数据卷（数据库 / 聊天图片 / 图标缓存都在 /data 下） ----
# 命名卷（默认）：VOLUME=stickykee-data:/data
# 如需 bind mount（沿用旧部署目录）：VOLUME=/vol2/homecanvas/data:/data
VOLUME=stickykee-data:/data

# ---- 重启策略 ----
RESTART=unless-stopped

# ---- 时区（仅容器运行环境用；数据库时间戳以此为准） ----
TZ=Asia/Shanghai

# ---- 可选：日志级别（debug / info / warn / error），空 = info ----
# SN_LOG_LEVEL=info
