<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- 条码扫描：全屏 CameraX 预览 + ML Kit 识别，结果经 stickykee-scan 事件回传 -->
        <activity
            android:name=".BarcodeScannerActivity"
            android:exported="false"
            android:theme="@style/AppTheme.NoActionBar" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- 前台保活服务：登录后启动，防后台冻结断连（通知低重要性无声音）。
             dataSync 保连接；location 用于后台刷新所在位置（需已授予定位权限） -->
        <service
            android:name=".KeepAliveService"
            android:exported="false"
            android:foregroundServiceType="dataSync|location" />

        <!-- 开机自启动：重启后恢复保活服务并拉起主界面（MIUI 需用户开「自启动」） -->
        <receiver
            android:name=".BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <!-- 应用更新覆盖安装后自动恢复常驻（无需再次重启手机） -->
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Doze 深睡唤醒心跳：精确闹钟投递（链式自延续，见 HeartbeatAlarm） -->
        <receiver
            android:name=".HeartbeatReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="cn.stickykee.app.HEARTBEAT" />
            </intent-filter>
        </receiver>

        <!-- 库存每日提醒：精确闹钟投递到点弹通知，自动顺延到次日（见 StockReminder） -->
        <receiver
            android:name=".StockReminderReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="cn.stickykee.app.STOCK_REMINDER" />
            </intent-filter>
        </receiver>

        <!-- 支付通知自动记账：监听微信 / 支付宝通知（用户需在系统「通知使用权」中授权） -->
        <service
            android:name=".FinanceNotificationService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 前台保活服务（dataSync 保连接 + location 后台刷新位置，Android 14 要求声明对应权限） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- 网络状态传感器（原生采集 connection_type / network_quality / wifi_ssid / bssid） -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- 电池优化白名单：SOS/常驻后台（微信级保活），登录后引导用户豁免 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- 应用内更新：下载 APK 后拉起系统安装器（Android 8+ 需用户允许安装未知应用） -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- 条码扫描：库存功能扫码（首次扫码时弹系统授权） -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- 无摄像头设备也允许安装（扫码入口按需降级） -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- 语音消息 / 语音通话：录音与音频路由（首次录音时弹系统授权） -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- 定位（navigator.geolocation）：未声明时 WebView 定位授权被系统直接拒绝，
         报 "User denied Geolocation"；首次定位时由 Capacitor 弹系统授权 -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- 后台定位：退后台后刷新所在位置（geocoded_location）需要；Android 11+ 需用户选「始终允许」 -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <!-- 状态栏通知：IM 新消息推送（Android 13+ 需运行时授权） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 开机自启动：重启后恢复常驻保活（前台服务 + 自动拉起主界面重建连接） -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Doze 精确闹钟：深睡中唤醒心跳，修复熄屏后位置/在线状态空白期。
         Android 12+ 的 SCHEDULE_EXACT_ALARM 需用户在「闹钟与提醒」中允许（启动保活时引导）；
         USE_EXACT_ALARM 在 13+ 安装即授予，本应用为自分发（非应用商店），声明之。 -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
</manifest>
