<?xml version="1.0" encoding="utf-8"?>
<!-- 服务器地址行：状态点 + 名称/URL + 内网外网徽标 + 编辑/删除
     注：minSdk=22，全部用 paddingLeft/paddingRight/marginLeft/marginRight
     （paddingHorizontal/Vertical 与 marginStart/End 是 API26+，旧机被忽略）。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/sc_card_bg"
    android:paddingLeft="14dp"
    android:paddingRight="14dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:layout_marginBottom="8dp">

    <!-- 在线状态点：灰=离线 / 主题色=探测中 / 绿=在线（代码切换背景） -->
    <View
        android:id="@+id/row_dot"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:layout_marginRight="12dp"
        android:background="@drawable/sc_status_off" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/row_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/sc_text"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:ellipsize="end"
                tools:text="家里内网" />

            <TextView
                android:id="@+id/row_active"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/sc_badge_bg"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:textColor="@color/sc_on_primary"
                android:textSize="10sp"
                android:text="使用中"
                android:visibility="gone"
                android:layout_marginLeft="6dp" />

            <TextView
                android:id="@+id/row_ver"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/sc_badge_bg"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:textColor="@color/sc_muted"
                android:textSize="10sp"
                android:visibility="gone"
                android:layout_marginLeft="6dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/row_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/sc_muted"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginTop="2dp" />

        <TextView
            android:id="@+id/row_conn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/sc_primary"
            android:textSize="12sp"
            android:text="正在探测并切换…"
            android:visibility="gone"
            android:layout_marginTop="6dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/row_type"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/sc_badge_bg"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:textSize="10sp"
        android:layout_marginLeft="8dp"
        android:text="内网" />

    <TextView
        android:id="@+id/row_edit"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:gravity="center"
        android:minWidth="44dp"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:text="编辑"
        android:textColor="@color/sc_muted"
        android:textSize="12sp"
        android:layout_marginLeft="8dp" />

    <TextView
        android:id="@+id/row_del"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:gravity="center"
        android:minWidth="44dp"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:text="删除"
        android:textColor="@color/sc_error"
        android:textSize="12sp" />
</LinearLayout>
